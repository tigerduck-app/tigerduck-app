// Template for Secrets.xcconfig. Copy this file to Secrets.xcconfig (which
// is gitignored) and replace the placeholder with the real token.
//
// The TigerDuck Xcode target reads TIGERDUCK_API_TOKEN at build time; the
// INFOPLIST_KEY_TigerDuckAPIToken mapping below surfaces the same value as
// the Info.plist entry PushCoordinator.resolveSharedSecret() looks up at
// runtime.
//
// Must match the server's TIGERDUCK_API_SHARED_SECRET (backend/.env) or
// every write request from this build will 401.
//
// Generate a fresh one with:
//   python3 -c "import secrets; print(secrets.token_urlsafe(32))"

TIGERDUCK_API_TOKEN = REPLACE_ME_WITH_THE_SAME_SECRET_AS_THE_SERVER
INFOPLIST_KEY_TigerDuckAPIToken = $(TIGERDUCK_API_TOKEN)
