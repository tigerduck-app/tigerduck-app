<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
    Template for Secrets.plist. Copy this file to Secrets.plist (which is
    gitignored) and replace the placeholder.

    Only Debug builds (Xcode Run) read this file, and only DebugServerURL:
    the base URL of your local dev backend. Use your Mac's LAN IP so a
    physical device can reach it. http:// is accepted only for loopback
    and private LAN hosts; any other host needs https://.

    Without a valid DebugServerURL, Debug builds use
    https://api.tigerduck.app/v3, as Release builds do. An API endpoint set
    in the app overrides both; the full order is in
    PushServerConfig.resolveServerURL().
-->
<plist version="1.0">
<dict>
    <key>DebugServerURL</key>
    <string>http://192.168.X.X:40000/v3</string>
</dict>
</plist>
