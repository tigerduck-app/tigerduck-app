<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
    Template for Secrets.plist. Copy this file to Secrets.plist (which is
    gitignored) and replace the placeholder.

    Only Debug builds (Xcode Run) read this file, and only DebugServerURL:
    the base URL of your local dev backend. Use your Mac's LAN IP so a
    physical device can reach it. Without a valid DebugServerURL, Debug
    builds fall back to http://localhost:40000/v3, which works on the
    Simulator but not on a physical device. http:// is accepted only for
    loopback and private LAN hosts; any other host needs https://.

    Release builds (TestFlight / App Store) use https://api.tigerduck.app/v3.
    An API endpoint set in the app overrides both; the full order is in
    PushServerConfig.resolveServerURL().
-->
<plist version="1.0">
<dict>
    <key>DebugServerURL</key>
    <string>http://192.168.X.X:40000/v3</string>
</dict>
</plist>
